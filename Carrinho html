<!DOCTYPE html>
<html lang="pt-br">
<head>
<meta charset="UTF-8">
<title>Finalizar Compra - DARK NIGHT</title>
<style>
body{background:#0a0a0a;color:white;font-family:Arial;text-align:center;padding:20px}
.caixa{background:#111;border:2px solid #9b30ff;border-radius:15px;padding:30px;max-width:500px;margin:50px auto;box-shadow:0 0 20px #9b30ff}
h1{color:#9b30ff}
input{padding:10px;width:80px;font-size:1.2em;text-align:center;background:#222;color:white;border:1px solid #9b30ff;border-radius:5px}
.total{font-size:2em;color:#9b30ff;margin:20px 0}
.btn{background:linear-gradient(135deg,#6a0dad,#9b30ff);color:white;padding:15px 30px;border:none;border-radius:10px;font-size:1.2em;font-weight:bold;cursor:pointer;margin-top:10px}
.pix{display:none;margin-top:20px}
.pix img{width:250px;border:3px solid #9b30ff;border-radius:10px}
.copiar{background:#222;padding:10px;border-radius:5px;margin:10px 0;word-break:break-all;cursor:pointer}
.copiar:hover{background:#333}
.sucesso{display:none;color:#00ff00;font-size:1.5em;margin-top:20px}
</style>
</head>
<body>
<div class="caixa">
<h1 id="tituloKit">Finalizando...</h1>
<p>Quantidade: <input type="number" id="qtd" value="1" min="1" onchange="calcular()"></p>
<p class="total">Total: R$ <span id="total">0.00</span></p>
<button class="btn" onclick="gerarPix()">Finalizar Compra</button>
<div class="pix" id="pixBox">
<h2>Pague com Pix</h2>
<img src="https://api.qrserver.com/v1/create-qr-code/?size=250x250&data=437144b6-5d40-4f01-b803-c33d1bf041c0" alt="QR Code Pix">
<p>Ou copie o código:</p>
<div class="copiar" onclick="copiarPix()">437144b6-5d40-4f01-b803-c33d1bf041c0</div>
<button class="btn" onclick="confirmar()">Já paguei</button>
</div>
<div class="sucesso" id="sucessoBox">✅ KIT ENVIADO COM SUCESSO! <br>Favor enviar comprovante no ticket do Discord</div>
</div>
<script>
const urlParams=new URLSearchParams(window.location.search);const kit=urlParams.get('kit');const preco=parseFloat(urlParams.get('preco'));
document.getElementById('tituloKit').innerText="Comprar: "+kit;document.getElementById('total').innerText=preco.toFixed(2);
function calcular(){const qtd=document.getElementById('qtd').value;document.getElementById('total').innerText=(preco*qtd).toFixed(2)}
function gerarPix(){document.getElementById('pixBox').style.display='block'}
function confirmar(){document.getElementById('pixBox').style.display='none';document.getElementById('sucessoBox').style.display='block'}
function copiarPix(){navigator.clipboard.writeText("437144b6-5d40-4f01-b803-c33d1bf041c0");alert("Chave Pix copiada!")}
</script>
</body>
</html>
